# AI chat (Gemini). Create a key at https://aistudio.google.com/apikey
LLM_CV_API_Key=
# Optional: model name (default gemini-2.5-flash)
GEMINI_MODEL=
# Optional: max chat messages per day per server instance (default 400)
CHAT_DAILY_LIMIT=

# Public address of the site (sitemap, canonical links). Default: https://bar-azulay-portfolio.vercel.app
NEXT_PUBLIC_SITE_URL=
# Google Analytics 4 measurement ID, e.g. G-ABC123XYZ. Leave empty to turn analytics off
NEXT_PUBLIC_GA_ID=
# Google Search Console verification: only the content="..." value of the HTML tag
NEXT_PUBLIC_GSC_VERIFICATION=
